{#
  Managed by redhatguru.general.gitlab — local edits are overwritten.

  Every setting below comes from a role variable, so this file is the whole
  configuration of the instance and a change to it is a diff rather than an
  archaeology exercise across /etc/gitlab. Settings the named variables do not
  cover go in gitlab_rails_extra_configuration (or the per-component
  *_extra_configuration dicts), and anything that is not a plain assignment
  goes in gitlab_extra_configuration, which is appended verbatim at the end.

  Values are converted to Ruby literals by the macro below: strings are
  quoted and escaped, booleans become true/false, None becomes nil, and lists
  and dicts become Ruby arrays and hashes. That is what lets a plain YAML
  variable configure a Ruby file without the caller having to think about
  quoting.
-#}
{%- macro rb(value) -%}
{%- if value is boolean -%}
{{ value | string | lower }}
{%- elif value is none -%}
nil
{%- elif value is number -%}
{{ value }}
{%- elif value is string -%}
{{ value | to_json }}
{%- elif value is mapping -%}
{ {% for key, item in value.items() %}{{ key | to_json }} => {{ rb(item) }}{{ ', ' if not loop.last }}{% endfor %} }
{%- elif value is sequence -%}
[{% for item in value %}{{ rb(item) }}{{ ', ' if not loop.last }}{% endfor %}]
{%- else -%}
{{ value | to_json }}
{%- endif -%}
{%- endmacro -%}
# Managed by redhatguru.general.gitlab — local edits are overwritten.
#
# Change a variable and re-run the role; do not edit this file on the host.

# --------------------------------------------------------------------------
# Instance identity
# --------------------------------------------------------------------------

external_url {{ rb(gitlab_external_url) }}

gitlab_rails['time_zone'] = {{ rb(gitlab_time_zone) }}
gitlab_rails['gitlab_shell_ssh_port'] = {{ gitlab_shell_ssh_port | int }}
{% if gitlab_trusted_proxies | length > 0 %}
gitlab_rails['trusted_proxies'] = {{ rb(gitlab_trusted_proxies) }}
{% endif %}
{% if gitlab_initial_root_password | length > 0 %}

# Applied on the first reconfigure only — once the root account exists, GitLab
# ignores this value, so changing it here does not reset the password.
gitlab_rails['initial_root_password'] = {{ rb(gitlab_initial_root_password) }}
{% endif %}
gitlab_rails['store_initial_root_password'] = {{ rb(gitlab_initial_root_password_store | bool) }}

# --------------------------------------------------------------------------
# Web server
# --------------------------------------------------------------------------

nginx['enable'] = {{ rb(gitlab_nginx_enabled | bool) }}
{% if gitlab_nginx_enabled | bool %}
nginx['listen_https'] = {{ rb(gitlab_nginx_listen_https_effective | bool) }}
{% if gitlab_nginx_listen_port | string | length > 0 %}
nginx['listen_port'] = {{ gitlab_nginx_listen_port | int }}
{% endif %}
nginx['redirect_http_to_https'] = {{ rb(gitlab_nginx_redirect_http_to_https | bool and gitlab_nginx_listen_https_effective | bool) }}
nginx['client_max_body_size'] = {{ rb(gitlab_nginx_client_max_body_size) }}
{% if gitlab_nginx_ssl_certificate_effective | trim | length > 0 %}
{# Either the files the caller manages, or the self-signed pair the role
   generated. Left out for Let's Encrypt, which puts its own certificate where
   GitLab looks for it, and over plain HTTP, where there is none. #}
nginx['ssl_certificate'] = {{ rb(gitlab_nginx_ssl_certificate_effective | trim) }}
nginx['ssl_certificate_key'] = {{ rb(gitlab_nginx_ssl_certificate_key_effective | trim) }}
{% endif %}
{# 0 is how nginx is told not to send the header at all — there is no separate switch. #}
nginx['hsts_max_age'] = {{ gitlab_nginx_hsts_max_age | int if (gitlab_nginx_hsts_enabled | bool and gitlab_nginx_listen_https_effective | bool) else 0 }}
{% if gitlab_trusted_proxies | length > 0 %}
nginx['real_ip_trusted_addresses'] = {{ rb(gitlab_trusted_proxies) }}
nginx['real_ip_header'] = "X-Forwarded-For"
nginx['real_ip_recursive'] = "on"
{% endif %}
{% for key, value in gitlab_nginx_extra_configuration | dictsort %}
nginx['{{ key }}'] = {{ rb(value) }}
{% endfor %}
{% endif %}

letsencrypt['enable'] = {{ rb(gitlab_tls_enabled | bool and gitlab_tls_certificate_source == 'letsencrypt') }}
{% if gitlab_tls_enabled | bool and gitlab_tls_certificate_source == 'letsencrypt' %}
letsencrypt['contact_emails'] = {{ rb(gitlab_letsencrypt_contact_emails) }}
letsencrypt['auto_renew'] = {{ rb(gitlab_letsencrypt_auto_renew | bool) }}
letsencrypt['auto_renew_hour'] = {{ gitlab_letsencrypt_auto_renew_hour | int }}
letsencrypt['auto_renew_minute'] = {{ gitlab_letsencrypt_auto_renew_minute | int }}
letsencrypt['auto_renew_day_of_month'] = {{ rb(gitlab_letsencrypt_auto_renew_day_of_month) }}
{% endif %}

# --------------------------------------------------------------------------
# Outgoing email
# --------------------------------------------------------------------------

gitlab_rails['gitlab_email_enabled'] = {{ rb(gitlab_email_enabled | bool) }}
{% if gitlab_email_enabled | bool %}
gitlab_rails['gitlab_email_from'] = {{ rb(gitlab_email_from) }}
gitlab_rails['gitlab_email_display_name'] = {{ rb(gitlab_email_display_name) }}
gitlab_rails['gitlab_email_reply_to'] = {{ rb(gitlab_email_reply_to) }}
{% endif %}

gitlab_rails['smtp_enable'] = {{ rb(gitlab_smtp_enabled | bool) }}
{% if gitlab_smtp_enabled | bool %}
gitlab_rails['smtp_address'] = {{ rb(gitlab_smtp_address) }}
gitlab_rails['smtp_port'] = {{ gitlab_smtp_port | int }}
gitlab_rails['smtp_authentication'] = {{ rb(gitlab_smtp_authentication) }}
gitlab_rails['smtp_enable_starttls_auto'] = {{ rb(gitlab_smtp_enable_starttls_auto | bool) }}
gitlab_rails['smtp_tls'] = {{ rb(gitlab_smtp_tls | bool) }}
gitlab_rails['smtp_openssl_verify_mode'] = {{ rb(gitlab_smtp_openssl_verify_mode) }}
gitlab_rails['smtp_domain'] = {{ rb(gitlab_smtp_domain) }}
{% if gitlab_smtp_user_name | length > 0 %}
gitlab_rails['smtp_user_name'] = {{ rb(gitlab_smtp_user_name) }}
gitlab_rails['smtp_password'] = {{ rb(gitlab_smtp_password) }}
{% endif %}
{% endif %}

# --------------------------------------------------------------------------
# Backups
# --------------------------------------------------------------------------
#
# GitLab prunes the data tarballs itself on the schedule set by
# backup_keep_time; the configuration backups in
# {{ gitlab_backup_config_path }} are pruned by a job the role installs.

gitlab_rails['backup_path'] = {{ rb(gitlab_backup_path) }}
gitlab_rails['backup_keep_time'] = {{ gitlab_backup_keep_time | int }}
gitlab_rails['backup_archive_permissions'] = {{ gitlab_backup_archive_permissions }}
{% if gitlab_backup_upload_connection | length > 0 %}
gitlab_rails['backup_upload_connection'] = {{ rb(gitlab_backup_upload_connection) }}
gitlab_rails['backup_upload_remote_directory'] = {{ rb(gitlab_backup_upload_remote_directory) }}
{% endif %}

# --------------------------------------------------------------------------
# Application services
# --------------------------------------------------------------------------

{% if gitlab_puma_worker_processes | string | length > 0 %}
puma['worker_processes'] = {{ gitlab_puma_worker_processes | int }}
{% endif %}
puma['min_threads'] = {{ gitlab_puma_min_threads | int }}
puma['max_threads'] = {{ gitlab_puma_max_threads | int }}
puma['per_worker_max_memory_mb'] = {{ gitlab_puma_per_worker_max_memory_mb | int }}
{% for key, value in gitlab_puma_extra_configuration | dictsort %}
puma['{{ key }}'] = {{ rb(value) }}
{% endfor %}

sidekiq['max_concurrency'] = {{ gitlab_sidekiq_max_concurrency | int }}
{% for key, value in gitlab_sidekiq_extra_configuration | dictsort %}
sidekiq['{{ key }}'] = {{ rb(value) }}
{% endfor %}

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------

postgresql['enable'] = {{ rb(gitlab_postgresql_enabled | bool and not gitlab_database_external_enabled | bool) }}
{% if gitlab_postgresql_enabled | bool and not gitlab_database_external_enabled | bool %}
{% if gitlab_postgresql_shared_buffers | length > 0 %}
postgresql['shared_buffers'] = {{ rb(gitlab_postgresql_shared_buffers) }}
{% endif %}
postgresql['max_connections'] = {{ gitlab_postgresql_max_connections | int }}
postgresql['max_worker_processes'] = {{ gitlab_postgresql_max_worker_processes | int }}
{% for key, value in gitlab_postgresql_extra_configuration | dictsort %}
postgresql['{{ key }}'] = {{ rb(value) }}
{% endfor %}
{% endif %}
{% if gitlab_database_external_enabled | bool %}

# External database: the bundled PostgreSQL above is switched off, so this is
# the only datastore GitLab has. The schema, the extensions and the backups of
# it are managed wherever that database lives — `gitlab-backup create` still
# dumps it, but only if this account may read every table.
gitlab_rails['db_adapter'] = "postgresql"
gitlab_rails['db_encoding'] = "unicode"
gitlab_rails['db_host'] = {{ rb(gitlab_database_host) }}
gitlab_rails['db_port'] = {{ gitlab_database_port | int }}
gitlab_rails['db_database'] = {{ rb(gitlab_database_name) }}
gitlab_rails['db_username'] = {{ rb(gitlab_database_user) }}
gitlab_rails['db_password'] = {{ rb(gitlab_database_password) }}
gitlab_rails['db_sslmode'] = {{ rb(gitlab_database_sslmode) }}
{% endif %}

redis['enable'] = {{ rb(gitlab_redis_enabled | bool) }}
{% if gitlab_redis_enabled | bool and gitlab_redis_maxmemory | length > 0 %}
redis['maxmemory'] = {{ rb(gitlab_redis_maxmemory) }}
{% endif %}
{% for key, value in gitlab_redis_extra_configuration | dictsort %}
redis['{{ key }}'] = {{ rb(value) }}
{% endfor %}

# --------------------------------------------------------------------------
# Optional components
# --------------------------------------------------------------------------

registry['enable'] = {{ rb(gitlab_registry_enabled | bool) }}
gitlab_rails['registry_enabled'] = {{ rb(gitlab_registry_enabled | bool) }}
{% if gitlab_registry_enabled | bool %}
registry_external_url {{ rb(gitlab_registry_external_url) }}
gitlab_rails['registry_path'] = {{ rb(gitlab_registry_storage_path) }}
{% for key, value in gitlab_registry_extra_configuration | dictsort %}
registry['{{ key }}'] = {{ rb(value) }}
{% endfor %}
{% for key, value in gitlab_registry_nginx_extra_configuration | dictsort %}
registry_nginx['{{ key }}'] = {{ rb(value) }}
{% endfor %}
{% endif %}

gitlab_pages['enable'] = {{ rb(gitlab_pages_enabled | bool) }}
{% if gitlab_pages_enabled | bool %}
pages_external_url {{ rb(gitlab_pages_external_url) }}
{% for key, value in gitlab_pages_extra_configuration | dictsort %}
gitlab_pages['{{ key }}'] = {{ rb(value) }}
{% endfor %}
{% endif %}

gitlab_kas['enable'] = {{ rb(gitlab_kas_enabled | bool) }}
mattermost['enable'] = {{ rb(gitlab_mattermost_enabled | bool) }}

# --------------------------------------------------------------------------
# Monitoring
# --------------------------------------------------------------------------

prometheus_monitoring['enable'] = {{ rb(gitlab_prometheus_enabled | bool) }}
prometheus['enable'] = {{ rb(gitlab_prometheus_enabled | bool) }}
node_exporter['enable'] = {{ rb(gitlab_node_exporter_enabled | bool) }}
alertmanager['enable'] = {{ rb(gitlab_alertmanager_enabled | bool) }}
{% for key, value in gitlab_prometheus_extra_configuration | dictsort %}
prometheus['{{ key }}'] = {{ rb(value) }}
{% endfor %}

# The health, readiness and metrics endpoints answer only these addresses.
# The role's own validation reads them over the loopback interface.
gitlab_rails['monitoring_whitelist'] = {{ rb(gitlab_monitoring_whitelist) }}

# --------------------------------------------------------------------------
# Authentication
# --------------------------------------------------------------------------

gitlab_rails['ldap_enabled'] = {{ rb(gitlab_ldap_enabled | bool) }}
{% if gitlab_ldap_enabled | bool %}
{# The YAML heredoc is GitLab's own documented form for this setting, and it
   keeps a nested server definition readable where a one-line Ruby hash would
   not be. #}
gitlab_rails['ldap_servers'] = YAML.load <<-'EOS'
{{ gitlab_ldap_servers | to_nice_yaml(indent=2) | trim | indent(2, true) }}
EOS
{% endif %}

gitlab_rails['omniauth_enabled'] = {{ rb(gitlab_omniauth_enabled | bool) }}
{% if gitlab_omniauth_enabled | bool %}
gitlab_rails['omniauth_allow_single_sign_on'] = {{ rb(gitlab_omniauth_allow_single_sign_on) }}
gitlab_rails['omniauth_block_auto_created_users'] = {{ rb(gitlab_omniauth_block_auto_created_users | bool) }}
gitlab_rails['omniauth_providers'] = {{ rb(gitlab_omniauth_providers) }}
{% endif %}
{% if gitlab_rails_extra_configuration | length > 0 %}

