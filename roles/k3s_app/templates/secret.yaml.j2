---
# Managed by redhatguru.general.k3s_app
#
# base64 in `data` rather than plain text in `stringData`. Not for secrecy —
# base64 is not encryption — but because stringData is write-only: the API
# server stores it under `data` and never echoes it back, so a re-run cannot
# tell whether the value changed and reports the Secret as modified every
# single time. With `data`, the comparison works and the task is idempotent.
#
# The values themselves belong in Ansible Vault, and the task that applies
# this object is no_log.
apiVersion: v1
kind: Secret
metadata:
  name: "{{ k3s_app_object.name }}"
  namespace: "{{ k3s_app_item.namespace }}"
  labels:
    app.kubernetes.io/name: "{{ k3s_app_item.name }}"
    app.kubernetes.io/instance: "{{ k3s_app_item.name }}"
    app.kubernetes.io/managed-by: ansible
type: "{{ k3s_app_object.type | default('Opaque') }}"
data:
{% for key, value in (k3s_app_object.string_data | default({})).items() %}
  {{ key }}: "{{ value | string | b64encode }}"
{% endfor %}
{% for key, value in (k3s_app_object.data | default({})).items() %}
  {{ key }}: "{{ value }}"
{% endfor %}
