---
# Managed by redhatguru.general.k3s_app
#
# Denies everything in and out of this namespace. Never applied on its own —
# the allow-rules that keep DNS and the ingress working go with it, because a
# default-deny without them is an outage, not a hardening measure.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: "{{ k3s_app_item.name }}-default-deny"
  namespace: "{{ k3s_app_item.namespace }}"
  labels:
    app.kubernetes.io/managed-by: ansible
spec:
  podSelector: {}
  policyTypes:
    - Ingress
    - Egress
