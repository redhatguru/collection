---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: kubernetes-dashboard
  namespace: kubernetes-dashboard
  annotations:
{% if kubernetes_dashboard_insecure_http_enabled %}
    # Talking plain HTTP to the Dashboard's insecure listener, and not
    # forcing a redirect to the HTTPS one — see
    # kubernetes_dashboard_insecure_http_enabled in defaults/main.yml.
    nginx.ingress.kubernetes.io/ssl-redirect: "false"
{% else %}
    # The Dashboard's Service only speaks HTTPS (self-signed cert, no
    # plain-HTTP listener), so ingress-nginx must be told to talk HTTPS to
    # the backend rather than the plain HTTP it defaults to.
    nginx.ingress.kubernetes.io/backend-protocol: "HTTPS"
{% endif %}
{% if kubernetes_dashboard_basic_auth_enabled %}
    nginx.ingress.kubernetes.io/auth-type: basic
    nginx.ingress.kubernetes.io/auth-secret: kubernetes-dashboard-basic-auth
    nginx.ingress.kubernetes.io/auth-realm: "Authentication Required - Kubernetes Dashboard"
{% endif %}
spec:
  ingressClassName: {{ kubernetes_dashboard_ingress_class_name }}
{% if kubernetes_dashboard_ingress_tls_secret %}
  tls:
    - hosts:
        - {{ kubernetes_dashboard_ingress_host }}
      secretName: {{ kubernetes_dashboard_ingress_tls_secret }}
{% endif %}
  rules:
    - host: {{ kubernetes_dashboard_ingress_host }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: kubernetes-dashboard
                port:
                  number: {{ 80 if kubernetes_dashboard_insecure_http_enabled else 443 }}
