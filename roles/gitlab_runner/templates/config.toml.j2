{#
  Managed by redhatguru.general.gitlab_runner — local edits are overwritten.

  Written from the role's variables rather than by `gitlab-runner register`,
  for the same reason gitlab.rb is: the whole configuration of this runner is
  then one reviewable file, and a change to it is a diff. Registration itself
  adds nothing the runner needs — an authentication token in this file is
  what makes it a registered runner, and `gitlab-runner verify` in
  tasks/validate.yml is what proves GitLab agrees.

  Values are converted to TOML literals by the macro below, so a plain YAML
  variable configures a TOML file without the caller thinking about quoting.
-#}
{%- macro toml(value) -%}
{%- if value is boolean -%}
{{ value | string | lower }}
{%- elif value is none -%}
""
{%- elif value is number -%}
{{ value }}
{%- elif value is string -%}
{{ value | to_json }}
{%- elif value is mapping -%}
{ {% for key, item in value.items() %}{{ key }} = {{ toml(item) }}{{ ', ' if not loop.last }}{% endfor %} }
{%- elif value is sequence -%}
[{% for item in value %}{{ toml(item) }}{{ ', ' if not loop.last }}{% endfor %}]
{%- else -%}
{{ value | to_json }}
{%- endif -%}
{%- endmacro -%}
# Managed by redhatguru.general.gitlab_runner — local edits are overwritten.
#
# Change a variable and re-run the role; do not edit this file on the host.

concurrent = {{ gitlab_runner_concurrent | int }}
check_interval = {{ gitlab_runner_check_interval | int }}
log_level = {{ toml(gitlab_runner_log_level) }}
log_format = {{ toml(gitlab_runner_log_format) }}
{% for key, value in gitlab_runner_global_extra_configuration | dictsort %}
{{ key }} = {{ toml(value) }}
{% endfor %}

[[runners]]
  name = {{ toml(gitlab_runner_description) }}
  url = {{ toml(gitlab_runner_url) }}
  token = {{ toml(gitlab_runner_token) }}
  executor = {{ toml(gitlab_runner_executor) }}
{% if gitlab_runner_limit | int > 0 %}
  limit = {{ gitlab_runner_limit | int }}
{% endif %}
  request_concurrency = {{ gitlab_runner_request_concurrency | int }}
  output_limit = {{ gitlab_runner_output_limit | int }}
{% if gitlab_runner_tls_ca_file_effective | trim | length > 0 %}
{# Read on every call to GitLab, and handed to the job's git through
   CI_SERVER_TLS_CA_FILE — which is what makes `git clone` inside a job work
   against a GitLab no public CA signed for. #}
  tls-ca-file = {{ toml(gitlab_runner_tls_ca_file_effective | trim) }}
{% endif %}
{% if gitlab_runner_environment | length > 0 %}
  environment = {{ toml(gitlab_runner_environment) }}
{% endif %}
{% for key, value in gitlab_runner_extra_configuration | dictsort %}
  {{ key }} = {{ toml(value) }}
{% endfor %}
{% if gitlab_runner_executor == 'docker' %}
  [runners.docker]
    tls_verify = {{ toml(gitlab_runner_docker_tls_verify | bool) }}
    image = {{ toml(gitlab_runner_docker_image) }}
{# A privileged job container can do anything to this host, including reading
   every other job's secrets. Off unless this deployment asked for it. #}
    privileged = {{ toml(gitlab_runner_docker_privileged | bool) }}
    volumes = {{ toml(gitlab_runner_docker_volumes) }}
    pull_policy = {{ toml(gitlab_runner_docker_pull_policy) }}
    shm_size = {{ gitlab_runner_docker_shm_size | int }}
{% if gitlab_runner_docker_network_mode | length > 0 %}
    network_mode = {{ toml(gitlab_runner_docker_network_mode) }}
{% endif %}
{% if gitlab_runner_docker_allowed_images | length > 0 %}
    allowed_images = {{ toml(gitlab_runner_docker_allowed_images) }}
{% endif %}
{% if gitlab_runner_docker_allowed_services | length > 0 %}
    allowed_services = {{ toml(gitlab_runner_docker_allowed_services) }}
{% endif %}
{% for key, value in gitlab_runner_docker_extra_configuration | dictsort %}
    {{ key }} = {{ toml(value) }}
{% endfor %}
{% endif %}
{% if gitlab_runner_cache_type | length > 0 %}
  [runners.cache]
    Type = {{ toml(gitlab_runner_cache_type) }}
    Shared = {{ toml(gitlab_runner_cache_shared | bool) }}
{% if gitlab_runner_cache_path | length > 0 %}
    Path = {{ toml(gitlab_runner_cache_path) }}
{% endif %}
{% if gitlab_runner_cache_type == 's3' and gitlab_runner_cache_s3 | length > 0 %}
    [runners.cache.s3]
{% for key, value in gitlab_runner_cache_s3 | dictsort %}
      {{ key }} = {{ toml(value) }}
{% endfor %}
{% endif %}
{% endif %}
{% if gitlab_runner_raw_configuration | trim | length > 0 %}

# --------------------------------------------------------------------------
# Raw configuration from gitlab_runner_raw_configuration
# --------------------------------------------------------------------------

{{ gitlab_runner_raw_configuration | trim }}
{% endif %}
