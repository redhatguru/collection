---
# Managed by redhatguru.general.k3s — local edits are overwritten.
crds:
  enabled: true

controller:
  enabled: true
{% if k3s_taint_control_plane | bool %}
  tolerations:
    - key: CriticalAddonsOnly
      operator: Exists
      effect: NoExecute
{% endif %}
  resources:
    requests:
      cpu: "50m"
      memory: "64Mi"
    limits:
      cpu: "200m"
      memory: "128Mi"

speaker:
  enabled: true
  # The speaker needs hostNetwork and NET_RAW to answer ARP for the service
  # addresses, which is why its namespace is exempt from the cluster-wide
  # "baseline" Pod Security Standard (see vars/main.yml).
{% if k3s_taint_control_plane | bool %}
  tolerations:
    - key: CriticalAddonsOnly
      operator: Exists
      effect: NoExecute
    - key: node-role.kubernetes.io/control-plane
      operator: Exists
      effect: NoSchedule
{% endif %}
  frr:
    # The legacy in-speaker FRR sidecar.
    enabled: {{ k3s_metallb_frr_enabled | bool | lower }}
  resources:
    requests:
      cpu: "50m"
      memory: "64Mi"
    limits:
      cpu: "200m"
      memory: "128Mi"

# Stated explicitly because the chart defaults this to true: left alone it
# deploys an frr-k8s DaemonSet and a status cleaner, and pulls two further
# container images, for BGP machinery that layer-2 mode never uses.
frrk8s:
  enabled: {{ k3s_metallb_frr_enabled | bool | lower }}
{% if k3s_metallb_extra_values | length > 0 %}

{{ k3s_metallb_extra_values | to_nice_yaml(indent=2) | trim }}
{% endif %}
