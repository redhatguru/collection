# Managed by redhatguru.general.k3s — local edits are overwritten.
#
# Let's Encrypt can only issue for names that resolve on the public internet.
# For an internal zone (.local, .lan, a split-horizon domain) use the "ca"
# type: it creates a self-signed root once and then issues from it, so the
# certificates are real certificates that a client can be made to trust.
{% for issuer in k3s_cert_manager_issuers %}
{% if issuer.type == 'selfsigned' %}
---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: "{{ issuer.name }}"
spec:
  selfSigned: {}
{% elif issuer.type == 'ca' %}
---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: "{{ issuer.name }}-bootstrap"
spec:
  selfSigned: {}
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: "{{ issuer.name }}-ca"
  namespace: "{{ k3s_cert_manager_namespace }}"
spec:
  isCA: true
  commonName: "{{ issuer.ca_common_name | default(issuer.name ~ ' Root CA') }}"
  duration: "{{ issuer.ca_duration | default('87600h') }}"
  renewBefore: "{{ issuer.ca_renew_before | default('720h') }}"
  secretName: "{{ issuer.name }}-ca"
  privateKey:
    algorithm: ECDSA
    size: 384
  issuerRef:
    name: "{{ issuer.name }}-bootstrap"
    kind: ClusterIssuer
    group: cert-manager.io
---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: "{{ issuer.name }}"
spec:
  ca:
    secretName: "{{ issuer.name }}-ca"
{% elif issuer.type == 'acme' %}
---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: "{{ issuer.name }}"
spec:
  acme:
    server: "{{ k3s_cert_manager_acme_servers[issuer.acme_server | default('staging')] }}"
    email: "{{ issuer.acme_email }}"
    privateKeySecretRef:
      name: "{{ issuer.name }}-account-key"
    solvers:
{% if issuer.solver | default('http01') == 'http01' %}
      - http01:
          ingress:
            ingressClassName: "{{ issuer.ingress_class | default(k3s_traefik_ingress_class) }}"
{% else %}
      # DNS-01 needs a provider-specific solver block; cert-manager supports
      # far more providers than this role can usefully model, so it is passed
      # through verbatim from the issuer definition.
      - dns01:
{{ issuer.dns01 | to_nice_yaml(indent=2) | trim | indent(10, true) }}
{% endif %}
{% if issuer.selector_dns_zones | default([]) | length > 0 %}
        selector:
          dnsZones:
{% for zone in issuer.selector_dns_zones %}
            - "{{ zone }}"
{% endfor %}
{% endif %}
{% endif %}
{% endfor %}
{% for raw in k3s_cert_manager_raw_issuers %}
---
{{ raw | to_nice_yaml(indent=2) | trim }}
{% endfor %}
