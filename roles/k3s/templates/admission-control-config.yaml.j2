---
# Managed by redhatguru.general.k3s — local edits are overwritten.
#
# Cluster-wide Pod Security Standards defaults. "enforce" is deliberately a
# level below "audit"/"warn": enforcing restricted cluster-wide stops MetalLB's
# speaker from starting, because it genuinely needs hostNetwork and NET_RAW.
# Namespaces that can take it are labelled for restricted individually —
# roles/k3s_app does that for every application namespace it creates.
apiVersion: apiserver.config.k8s.io/v1
kind: AdmissionConfiguration
plugins:
  - name: PodSecurity
    configuration:
      apiVersion: pod-security.admission.config.k8s.io/v1
      kind: PodSecurityConfiguration
      defaults:
        enforce: "{{ k3s_pod_security_enforce }}"
        enforce-version: "latest"
        audit: "{{ k3s_pod_security_audit }}"
        audit-version: "latest"
        warn: "{{ k3s_pod_security_warn }}"
        warn-version: "latest"
      exemptions:
        usernames: []
        runtimeClasses: []
        namespaces:
{% for namespace in k3s_pod_security_exempt_effective_namespaces %}
          - "{{ namespace }}"
{% endfor %}
